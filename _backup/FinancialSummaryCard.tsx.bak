import React from 'react';
import { DollarSign, Calculator, CalendarClock, ShieldCheck, ArrowRight } from 'lucide-react';
import { FinancialData } from '../types/jobData';
import { formatCurrency } from '../services/pdfService';

interface FinancialSummaryCardProps {
  financials: FinancialData;
  onRcvChange: (val: number | '') => void;
  onDeductibleChange: (val: number | '') => void;
}

export const FinancialSummaryCard: React.FC<FinancialSummaryCardProps> = ({
  financials,
  onRcvChange,
  onDeductibleChange,
}) => {
  return (
    <div className="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white rounded-2xl p-4 sm:p-6 shadow-xl border border-slate-700/60 mb-6">
      <div className="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 pb-4 border-b border-slate-700/60">
        <div className="flex items-center space-x-3">
          <div className="p-2.5 rounded-xl bg-red-600/20 text-red-400 border border-red-500/30">
            <Calculator className="w-5 h-5" />
          </div>
          <div>
            <h2 className="text-lg font-bold text-white tracking-tight flex items-center gap-2">
              Financial Breakdown & Contract Timelines
              <span className="text-[11px] font-medium bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full">
                Auto-Calculated
              </span>
            </h2>
            <p className="text-xs text-slate-300">
              Live synchronized with Structural Repair Agreement & Production Checklist
            </p>
          </div>
        </div>

        {/* Contract Timelines Badge (Hardcoded defaults 10 days to commence, 60 days to complete) */}
        <div className="flex items-center space-x-2 bg-slate-800/90 border border-slate-700 px-3.5 py-1.5 rounded-xl text-xs">
          <CalendarClock className="w-4 h-4 text-amber-400" />
          <span className="text-slate-400">Timelines:</span>
          <span className="font-semibold text-amber-300 bg-amber-400/10 px-2 py-0.5 rounded">
            {financials.commenceDays} Days Commence
          </span>
          <ArrowRight className="w-3 h-3 text-slate-500" />
          <span className="font-semibold text-amber-300 bg-amber-400/10 px-2 py-0.5 rounded">
            {financials.completeDays} Days Complete
          </span>
        </div>
      </div>

      {/* Grid of Inputs & Read-Only Computed Values */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 pt-4">
        {/* Input 1: Total Approved RCV */}
        <div className="bg-slate-800/80 rounded-xl p-3.5 border border-slate-700 focus-within:border-red-500 focus-within:ring-2 focus-within:ring-red-500/20 transition-all">
          <label className="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
            Total Approved RCV *
          </label>
          <div className="relative mt-1">
            <span className="absolute inset-y-0 left-0 pl-2.5 flex items-center text-slate-400 font-medium">
              $
            </span>
            <input
              type="number"
              step="0.01"
              value={financials.totalApprovedRcv}
              onChange={(e) => {
                const val = e.target.value === '' ? '' : parseFloat(e.target.value);
                onRcvChange(val);
              }}
              placeholder="0.00"
              className="w-full pl-6 pr-2 py-1.5 bg-slate-900/90 border border-slate-600 rounded-lg text-white font-bold text-sm focus:outline-none focus:border-red-500"
            />
          </div>
          <span className="text-[10px] text-slate-400 mt-1 block">Full claim replacement value</span>
        </div>

        {/* Input 2: Deductible */}
        <div className="bg-slate-800/80 rounded-xl p-3.5 border border-slate-700 focus-within:border-red-500 focus-within:ring-2 focus-within:ring-red-500/20 transition-all">
          <label className="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
            Deductible *
          </label>
          <div className="relative mt-1">
            <span className="absolute inset-y-0 left-0 pl-2.5 flex items-center text-slate-400 font-medium">
              $
            </span>
            <input
              type="number"
              step="0.01"
              value={financials.deductible}
              onChange={(e) => {
                const val = e.target.value === '' ? '' : parseFloat(e.target.value);
                onDeductibleChange(val);
              }}
              placeholder="0.00"
              className="w-full pl-6 pr-2 py-1.5 bg-slate-900/90 border border-slate-600 rounded-lg text-white font-bold text-sm focus:outline-none focus:border-red-500"
            />
          </div>
          <span className="text-[10px] text-slate-400 mt-1 block">Paid by property owner</span>
        </div>

        {/* Computed 1: Net Claim Value (RCV - Deductible) */}
        <div className="bg-slate-900/90 rounded-xl p-3.5 border border-emerald-500/30 bg-emerald-950/20 relative overflow-hidden">
          <div className="absolute top-2 right-2 text-[10px] font-bold text-emerald-400 bg-emerald-900/40 px-1.5 py-0.5 rounded">
            RCV - Deductible
          </div>
          <label className="block text-[11px] font-bold text-emerald-300 uppercase tracking-wider mb-1">
            Net Claim Value
          </label>
          <div className="text-lg font-black text-emerald-400 mt-1.5">
            {formatCurrency(financials.netClaimValue)}
          </div>
          <span className="text-[10px] text-emerald-300/80 mt-1 block">Insurance Responsibility</span>
        </div>

        {/* Computed 2: Down Payment (50%) */}
        <div className="bg-slate-900/90 rounded-xl p-3.5 border border-sky-500/30 bg-sky-950/20 relative overflow-hidden">
          <div className="absolute top-2 right-2 text-[10px] font-bold text-sky-400 bg-sky-900/40 px-1.5 py-0.5 rounded">
            50% Total
          </div>
          <label className="block text-[11px] font-bold text-sky-300 uppercase tracking-wider mb-1">
            Down Payment
          </label>
          <div className="text-lg font-black text-sky-400 mt-1.5">
            {formatCurrency(financials.downPayment)}
          </div>
          <span className="text-[10px] text-sky-300/80 mt-1 block">Due prior to commencement</span>
        </div>

        {/* Computed 3: Mid-Progress Payment (25%) */}
        <div className="bg-slate-900/90 rounded-xl p-3.5 border border-amber-500/30 bg-amber-950/20 relative overflow-hidden">
          <div className="absolute top-2 right-2 text-[10px] font-bold text-amber-400 bg-amber-900/40 px-1.5 py-0.5 rounded">
            25% Total
          </div>
          <label className="block text-[11px] font-bold text-amber-300 uppercase tracking-wider mb-1">
            Mid-Progress (25%)
          </label>
          <div className="text-lg font-black text-amber-400 mt-1.5">
            {formatCurrency(financials.midProgressPayment)}
          </div>
          <span className="text-[10px] text-amber-300/80 mt-1 block">Due at 50% milestone</span>
        </div>

        {/* Computed 4: Balance (Remaining 25%) */}
        <div className="bg-slate-900/90 rounded-xl p-3.5 border border-purple-500/30 bg-purple-950/20 relative overflow-hidden">
          <div className="absolute top-2 right-2 text-[10px] font-bold text-purple-400 bg-purple-900/40 px-1.5 py-0.5 rounded">
            Remaining
          </div>
          <label className="block text-[11px] font-bold text-purple-300 uppercase tracking-wider mb-1">
            Balance Due
          </label>
          <div className="text-lg font-black text-purple-400 mt-1.5">
            {formatCurrency(financials.balancePayment)}
          </div>
          <span className="text-[10px] text-purple-300/80 mt-1 block">Due on final walk-through</span>
        </div>
      </div>
